#!/bin/bash
# stdin -> the Mac's clipboard, via the reverse SSH tunnel (localhost:2489).
# Works from anywhere on the box (mosh, tmux, cron) because it needs no X.
# Also mirrors into the box's own X clipboard so local X apps can paste it.
tmp=$(mktemp); trap 'rm -f "$tmp"' EXIT
cat > "$tmp"

sent=0
if { exec 3<>/dev/tcp/127.0.0.1/2489; } 2>/dev/null; then
    { printf 'COPY\n'; cat "$tmp"; } >&3
    exec 3>&-
    sent=1
fi

export DISPLAY="${DISPLAY:-:1}"
if xset q >/dev/null 2>&1; then
    xclip -selection clipboard -i < "$tmp" >/dev/null 2>&1
fi

if [ "$sent" -eq 0 ]; then
    echo "pbcopy: Mac bridge unreachable (is devports running?) — copied to the box's X clipboard only" >&2
fi
